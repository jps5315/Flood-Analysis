        {"name": "max_cross_sectional_area_sf", "type": "DOUBLE", "alias": "Max Cross-Sectional Area Sq Ft (3D volume)", "required": true},
        {"name": "impact_rule", "type": "TEXT", "length": 64, "alias": "Impact Rule", "required": true}
