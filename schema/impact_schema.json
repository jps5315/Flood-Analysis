        {"name": "run_time_utc", "type": "DATE", "alias": "Run Time UTC", "required": true},
        {"name": "scenario_name", "type": "TEXT", "length": 128, "alias": "Scenario Name", "required": true},
        {"name": "aoi_name", "type": "TEXT", "length": 128, "alias": "AOI Name", "required": true},
