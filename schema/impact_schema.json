        {"name": "input_metadata", "type": "TEXT", "length": 2000, "alias": "Input Metadata (JSON)", "required": true},
        {"name": "result_summary", "type": "TEXT", "length": 2000, "alias": "Result Summary (JSON)", "required": false},
        {"name": "failure_summary", "type": "TEXT", "length": 2000, "alias": "Failure Summary (JSON)", "required": false}
      ]
    },
    "StepLog": {
      "geometry_type": "TABLE",
      "fields": [
        {"name": "run_id", "type": "TEXT", "length": 64, "alias": "Run ID", "required": true},
        {"name": "step_id", "type": "TEXT", "length": 64, "alias": "Step ID", "required": true},
        {"name": "step_name", "type": "TEXT", "length": 128, "alias": "Step Name", "required": true},
