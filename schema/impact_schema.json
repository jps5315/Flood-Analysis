        {"name": "max_single_year_cross_sectional_area_sf", "type": "DOUBLE", "alias": "Max Single Year Cross-Sectional Area Sq Ft (3D volume)", "required": true},
        {"name": "years_with_flood_count", "type": "SHORT", "alias": "Years With Flood Count (of 3)", "required": true},
        {"name": "impact_flag", "type": "SHORT", "alias": "Impact Flag", "required": true},
